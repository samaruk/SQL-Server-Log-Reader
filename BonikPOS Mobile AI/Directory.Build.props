<Project>
  <!-- This solution deliberately does not import the parent repository's Directory.Build.props. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Company>BonikPOS</Company>
    <Product>BonikPOS Owner-Voice Medicine Search</Product>
    <Version>0.1.0</Version>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Root of the solution, used to locate bundled models and test fixtures. -->
    <BonikSolutionRoot>$(MSBuildThisFileDirectory)</BonikSolutionRoot>
  </PropertyGroup>
</Project>
