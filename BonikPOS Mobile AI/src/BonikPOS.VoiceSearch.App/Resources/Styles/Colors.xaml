<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- BonikPOS-inspired pharmacy palette. Text/background pairs meet WCAG AA (4.5:1) in both themes.
         Android system colors: Platforms/Android/Resources/values/colors.xml -->

    <Color x:Key="Primary">#0B6E5F</Color>
    <Color x:Key="PrimaryDark">#5CC7B2</Color>
    <Color x:Key="PrimaryDarkText">#06201B</Color>
    <Color x:Key="Secondary">#D7F0EA</Color>
    <Color x:Key="SecondaryDarkText">#8ED9C9</Color>
    <Color x:Key="Tertiary">#084D43</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#B45309</Color>
    <Color x:Key="MidnightBlue">#06201B</Color>
    <Color x:Key="OffBlack">#101413</Color>

    <Color x:Key="Gray100">#E3E8E6</Color>
    <Color x:Key="Gray200">#C9D1CE</Color>
    <Color x:Key="Gray300">#AAB5B1</Color>
    <Color x:Key="Gray400">#8C9894</Color>
    <Color x:Key="Gray500">#6A7672</Color>
    <Color x:Key="Gray600">#3F4A47</Color>
    <Color x:Key="Gray900">#1B2220</Color>
    <Color x:Key="Gray950">#121816</Color>

    <!-- Semantic colors -->
    <Color x:Key="PageLight">#F5F7F6</Color>
    <Color x:Key="PageDark">#101413</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#1B2220</Color>
    <Color x:Key="TextLight">#111827</Color>
    <Color x:Key="TextDark">#F3F4F6</Color>
    <Color x:Key="MutedLight">#4B5563</Color>
    <Color x:Key="MutedDark">#B7C0BD</Color>
    <Color x:Key="WarningText">#92400E</Color>
    <Color x:Key="WarningBack">#FEF3C7</Color>
    <Color x:Key="WarningTextDark">#FCD34D</Color>
    <Color x:Key="WarningBackDark">#3A2A08</Color>
    <Color x:Key="DangerText">#991B1B</Color>
    <Color x:Key="DangerBack">#FEE2E2</Color>
    <Color x:Key="DangerTextDark">#FCA5A5</Color>
    <Color x:Key="DangerBackDark">#3B1212</Color>
    <Color x:Key="SuccessText">#166534</Color>
    <Color x:Key="SuccessBack">#DCFCE7</Color>
    <Color x:Key="SuccessTextDark">#86EFAC</Color>
    <Color x:Key="SuccessBackDark">#0F2E1A</Color>
    <Color x:Key="InfoText">#1E40AF</Color>
    <Color x:Key="InfoBack">#DBEAFE</Color>
    <Color x:Key="InfoTextDark">#93C5FD</Color>
    <Color x:Key="InfoBackDark">#13213F</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
